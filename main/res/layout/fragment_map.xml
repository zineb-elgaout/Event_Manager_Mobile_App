<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Google Map -->
    <fragment
        android:id="@+id/googleMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Top gradient for status bar readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_gradient_overlay"
        android:rotation="180"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carte des événements"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/urbanist_bold"
            android:shadowColor="#80000000"
            android:shadowRadius="4"/>

        <!-- Category filter chips -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMapCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_category"/>

    </LinearLayout>

    <!-- My location button -->
    <ImageView
        android:id="@+id/btnMyLocation"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:padding="11dp"
        android:src="@drawable/ic_location"
        android:background="@drawable/bg_map_button"
        android:elevation="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/eventCardContainer"
        android:layout_marginBottom="16dp"/>

    <!-- Recenter / Show all button -->
    <ImageView
        android:id="@+id/btnShowAll"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:padding="11dp"
        android:src="@drawable/ic_layers"
        android:background="@drawable/bg_map_button"
        android:elevation="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnMyLocation"/>

    <!-- Results count badge -->
    <TextView
        android:id="@+id/tvResultsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_filter_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:fontFamily="@font/urbanist_semibold"
        android:elevation="4dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/eventCardContainer"
        android:layout_marginBottom="16dp"
        tools:text="📍 12 événements"/>

    <!-- ═══ Bottom: selected event mini-card ═══ -->
    <FrameLayout
        android:id="@+id/eventCardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_map_bottom_sheet"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Default state: hint -->
        <LinearLayout
            android:id="@+id/hintContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_onboarding_dot_inactive"
                android:layout_marginBottom="16dp"/>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_map_marker"
                android:alpha="0.4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touchez un marqueur pour voir les détails"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/urbanist_regular"
                android:layout_marginTop="10dp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Selected event card -->
        <LinearLayout
            android:id="@+id/selectedEventCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_onboarding_dot_inactive"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivSelectedEventImage"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/RoundedImage12"
                    android:background="@drawable/placeholder_event"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvSelectedCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_category_tag"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:fontFamily="@font/urbanist_bold"
                        android:layout_marginBottom="6dp"
                        tools:text="FESTIVAL"/>

                    <TextView
                        android:id="@+id/tvSelectedTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/urbanist_bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Marrakech Music Festival 2026"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_location"/>

                        <TextView
                            android:id="@+id/tvSelectedLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/urbanist_regular"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Palmeraie, Marrakech"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="8dp">

                    <TextView
                        android:id="@+id/tvSelectedPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_green"
                        android:textSize="14sp"
                        android:fontFamily="@font/urbanist_bold"
                        tools:text="450 MAD"/>

                    <TextView
                        android:id="@+id/tvSelectedDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp"
                        android:fontFamily="@font/urbanist_regular"
                        android:layout_marginTop="2dp"
                        tools:text="12.3 km"/>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewEvent"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="Voir l'événement"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/urbanist_semibold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>