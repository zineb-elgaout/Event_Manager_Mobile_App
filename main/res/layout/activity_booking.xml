<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bookingForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:paddingTop="48dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/bg_social_button"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Réservation"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="@font/urbanist_bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/eventSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_event"
            android:padding="12dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/headerContainer">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivEventImage"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedImage12"
                android:background="@drawable/placeholder_event"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/tvEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/urbanist_bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Marrakech Music Festival 2026"/>

                <TextView
                    android:id="@+id/tvEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/urbanist_regular"
                    android:layout_marginTop="4dp"
                    tools:text="15 Juin 2026 • 20h00"/>

                <TextView
                    android:id="@+id/tvEventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/urbanist_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Palmeraie, Marrakech"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quantityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_event"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/eventSummaryCard">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre de billets"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/urbanist_bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maximum 8 par réservation"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/urbanist_regular"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDecrease"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_minus"
                android:background="@drawable/bg_quantity_button"/>

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="@font/urbanist_bold"/>

            <ImageView
                android:id="@+id/btnIncrease"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_plus"
                android:background="@drawable/bg_quantity_button"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/priceBreakdownCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_event"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/quantityCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Prix unitaire"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/urbanist_regular"/>

                <TextView
                    android:id="@+id/tvUnitPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/urbanist_semibold"
                    tools:text="450 MAD"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Frais de service"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/urbanist_regular"/>

                <TextView
                    android:id="@+id/tvServiceFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/urbanist_semibold"
                    tools:text="20 MAD"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="@font/urbanist_bold"/>

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:fontFamily="@font/urbanist_bold"
                    tools:text="470 MAD"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="20dp"
            android:text="Confirmer la réservation"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/urbanist_semibold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ticketConfirmation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="60dp"
            android:paddingBottom="40dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_check_circle"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Réservation confirmée !"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/urbanist_bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvConfirmationSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/urbanist_regular"
                android:gravity="center"
                android:layout_marginTop="6dp"
                tools:text="2 billets pour Marrakech Music Festival"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_white_card"
                android:padding="24dp"
                android:layout_marginTop="28dp">

                <TextView
                    android:id="@+id/tvTicketEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bg_main"
                    android:textSize="17sp"
                    android:fontFamily="@font/urbanist_bold"
                    android:gravity="center"
                    tools:text="Marrakech Music Festival 2026"/>

                <TextView
                    android:id="@+id/tvTicketEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:fontFamily="@font/urbanist_regular"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    tools:text="15 Juin 2026 • 20h00"/>

                <TextView
                    android:id="@+id/tvTicketEventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:fontFamily="@font/urbanist_regular"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"
                    tools:text="Palmeraie, Marrakech"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="20dp"/>

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    tools:src="@drawable/placeholder_event"/>

                <TextView
                    android:id="@+id/tvTicketCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:fontFamily="@font/urbanist_regular"
                    android:gravity="center"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.1"
                    tools:text="EVT-A1B2C3D4"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareTicket"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Partager"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/urbanist_semibold"
                    app:icon="@drawable/ic_share"
                    app:iconTint="@color/text_primary"
                    app:iconGravity="textStart"
                    style="@style/Widget.EventManager.Button.Secondary"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDone"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Terminé"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/urbanist_semibold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="14dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>